echo -e "#!/bin/sh\\nRE=true\\nl(){ echo \"[$1] $2\";}\\nd(){ l E \"$1\";exit 1;}\\nc(){[ $? -eq 0 ]&&exit 0;[ \"$RE\"=f ]&&exit 0;pkill -f fridaserver 2>/dev/null||true;rm -f *.apk 2>/dev/null||true;}\\ntrap c EXIT\\nr(){repo=\${1#*/};repo=\${repo%.git};curl -s \"https://api.github.com/repos/\$repo/releases/latest\"|grep browser_download_url|cut -d\\\\\" -f4;}\\ndl(){[ -f \"$2\" ]&&[ -s \"$2\" ]&&return;l I \"Downloading...\";curl -L --progress-bar -o \"$2\" \"$1\"||d \"DL fail\";[ -f \"$2\" ]&&[ -s \"$2\" ]||d \"Empty\";}\\ni(){[ -f \"$1\" ]||d \"Not found\";pm install -r \"$1\"||d \"Install fail\";}\\nm(){l I \"Start\";cd .||d \"Dir fail\";dl \"https://haval.joaoiot.com.br/fridaserver.rar\" \"fridaserver\";dl \"https://haval.joaoiot.com.br/fridainject.rar\" \"fridainject\";dl \"https://haval.joaoiot.com.br/system_server.js\" \"system_server.js\";dl \"\$(r https://github.com/RikkaApps/Shizuku)\" \"shizuku.apk\";dl \"\$(r https://github.com/bobaoapae/haval-app-tool-multimidia)\" \"haval.apk\";chmod +x fridaserver fridainject||d \"Chmod fail\";pgrep fridaserver>/dev/null||{setsid ./fridaserver>/dev/null 2>&1</dev/null &;sleep 2;pgrep fridaserver>/dev/null||d \"Srv fail\";};[ -f system_server.js ]||d \"JS miss\";SP=\$(pidof system_server)||d \"PID fail\";./fridainject -p \"$SP\" -s system_server.js &;sleep 1;i shizuku.apk;i haval.apk;rm -f *.apk;RE=f;echo \"Done\";}\\nm" > /data/local/tmp/install.sh

cd /data/local/tmp

sh /data/local/tmp/install.sh
